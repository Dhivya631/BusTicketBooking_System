<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="officer-summary"
              pageWidth="900" pageHeight="842"
              columnWidth="690" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">
    <field name="id" class="java.lang.Long"/>
    <field name="name" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="busNumber" class="java.lang.String"/>
    <field name="origin" class="java.lang.String"/>
    <field name="destination" class="java.lang.String"/>
    <field name="arrivalTime" class="java.time.LocalDateTime"/>
    <field name="departureTime" class="java.time.LocalDateTime"/>
    <field name="seatNumber" class="java.lang.Integer"/>
    <field name="bookingDate" class="java.time.LocalDate"/>
    <field name="paymentStatus" class="java.lang.String"/>
    <field name="fare" class="java.lang.Double"/>

    <!-- Title Band -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Booking Summary Report]]></text>
            </staticText>
        </band>
    </title>

    <!-- Column Header Band -->
    <columnHeader>
        <band height="20">
            <!-- Booking ID -->
            <staticText>
                <reportElement x="0" y="0" width="40" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <!-- Name -->
            <staticText>
                <reportElement x="40" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Name]]></text>
            </staticText>

            <!-- Email -->
            <staticText>
                <reportElement x="120" y="0" width="120" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Email]]></text>
            </staticText>

            <!-- Bus Number -->
            <staticText>
                <reportElement x="240" y="0" width="60" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Bus No]]></text>
            </staticText>

            <!-- Origin -->
            <staticText>
                <reportElement x="300" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Origin]]></text>
            </staticText>

            <!-- Destination -->
            <staticText>
                <reportElement x="380" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Destination]]></text>
            </staticText>

            <!-- Arrival Time -->
            <staticText>
                <reportElement x="460" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Arrival]]></text>
            </staticText>

            <!-- Departure Time -->
            <staticText>
                <reportElement x="540" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Departure]]></text>
            </staticText>

            <!-- Seat Number -->
            <staticText>
                <reportElement x="620" y="0" width="40" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Seat]]></text>
            </staticText>

            <!-- Booking Date -->
            <staticText>
                <reportElement x="660" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Booking Date]]></text>
            </staticText>

            <!-- Payment Status -->
            <staticText>
                <reportElement x="740" y="0" width="80" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Payment]]></text>
            </staticText>

            <!-- Fare -->
            <staticText>
                <reportElement x="820" y="0" width="50" height="20" backcolor="#d3d3d3"/>
                <box>
                    <pen lineWidth="1.0" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Fare]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="20">
            <!-- Booking ID -->
            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <!-- Name -->
            <textField>
                <reportElement x="40" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>

            <!-- Email -->
            <textField isStretchWithOverflow="true">
                <reportElement x="120" y="0" width="120" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>

            <!-- Bus Number -->
            <textField>
                <reportElement x="240" y="0" width="60" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{busNumber}]]></textFieldExpression>
            </textField>

            <!-- Origin -->
            <textField isStretchWithOverflow="true">
                <reportElement x="300" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{origin}]]></textFieldExpression>
            </textField>

            <!-- Destination -->
            <textField isStretchWithOverflow="true">
                <reportElement x="380" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{destination}]]></textFieldExpression>
            </textField>

            <!-- Arrival Time -->
            <textField>
                <reportElement x="460" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{arrivalTime}]]></textFieldExpression>
            </textField>

            <!-- Departure Time -->
            <textField>
                <reportElement x="540" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{departureTime}]]></textFieldExpression>
            </textField>

            <!-- Seat Number -->
            <textField>
                <reportElement x="620" y="0" width="40" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{seatNumber}]]></textFieldExpression>
            </textField>

            <!-- Booking Date -->
            <textField>
                <reportElement x="660" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{bookingDate}]]></textFieldExpression>
            </textField>

            <!-- Payment Status -->
            <textField>
                <reportElement x="740" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{paymentStatus}]]></textFieldExpression>
            </textField>

            <!-- Fare -->
            <textField>
                <reportElement x="820" y="0" width="50" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000"/>
                </box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{fare}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer Band -->
    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Generated on: ]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="0" width="155" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
